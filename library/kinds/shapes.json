[
  {"id":"rect","name":"Rectangle","category":"basic","tags":["box","process","card","square"],"description":"Rectangle; radius rounds the corners (use a large radius for pills)","size":[160,80],
   "params":{"radius":{"type":"number","default":0,"min":0,"max":400,"label":"Corner radius"}},
   "style":{"fill":"#ffffff","stroke":"#1f2328","strokeWidth":2},"text":{"size":16,"color":"#1f2328"},
   "svg":"<rect x='{sw/2}' y='{sw/2}' width='{max(0,w-sw)}' height='{max(0,h-sw)}' rx='{max(0,min(radius,(w-sw)/2,(h-sw)/2))}' {@paint}/>",
   "textBox":["8","4","w-16","h-8"]},

  {"id":"ellipse","name":"Ellipse","category":"basic","tags":["circle","oval","bubble","node"],"description":"Ellipse or circle filling the box","size":[120,120],
   "style":{"fill":"#ffffff","stroke":"#1f2328","strokeWidth":2},"text":{"size":16,"color":"#1f2328"},
   "svg":"<ellipse cx='{w/2}' cy='{h/2}' rx='{max(0,w/2-sw/2)}' ry='{max(0,h/2-sw/2)}' {@paint}/>",
   "textBox":["w*0.146","h*0.146","w*0.708","h*0.708"],"outline":"ellipse"},

  {"id":"pill","name":"Pill","category":"basic","tags":["stadium","terminator","rounded","capsule","tag","button","start","end"],"description":"Stadium / capsule: rectangle with fully round ends","size":[180,56],
   "style":{"fill":"#ffffff","stroke":"#1f2328","strokeWidth":2},"text":{"size":16,"color":"#1f2328"},
   "svg":"<rect x='{sw/2}' y='{sw/2}' width='{max(0,w-sw)}' height='{max(0,h-sw)}' rx='{max(0,min(w,h)/2-sw/2)}' {@paint}/>",
   "textBox":["min(w,h)*0.3","2","w-min(w,h)*0.6","h-4"]},

  {"id":"diamond","name":"Diamond","category":"flowchart","tags":["decision","rhombus","condition"],"description":"Diamond / decision","size":[140,100],
   "style":{"fill":"#ffffff","stroke":"#1f2328","strokeWidth":2},"text":{"size":15,"color":"#1f2328"},
   "svg":"<polygon points='{w/2},{sw*0.7} {w-sw*0.7},{h/2} {w/2},{h-sw*0.7} {sw*0.7},{h/2}' {@paint}/>",
   "textBox":["w/4","h/4","w/2","h/2"],"outline":"diamond"},

  {"id":"triangle","name":"Triangle","category":"basic","tags":["warning","delta"],"description":"Upward triangle (rotate for other directions)","size":[120,100],
   "style":{"fill":"#ffffff","stroke":"#1f2328","strokeWidth":2},"text":{"size":14,"color":"#1f2328"},
   "svg":"<polygon points='{w/2},{sw} {w-sw/2},{h-sw/2} {sw/2},{h-sw/2}' {@paint}/>",
   "textBox":["w/4","h*0.45","w/2","h*0.5"],"outline":{"poly":[["w/2","0"],["w","h"],["0","h"]]}},

  {"id":"hexagon","name":"Hexagon","category":"basic","tags":["preparation","polygon"],"description":"Horizontal hexagon; inset is the fraction of width cut at each side","size":[160,90],
   "params":{"inset":{"type":"number","default":0.2,"min":0,"max":0.5,"step":0.01,"label":"Inset"}},
   "style":{"fill":"#ffffff","stroke":"#1f2328","strokeWidth":2},"text":{"size":15,"color":"#1f2328"},
   "svg":"<polygon points='{w*inset},{sw/2} {w-w*inset},{sw/2} {w-sw/2},{h/2} {w-w*inset},{h-sw/2} {w*inset},{h-sw/2} {sw/2},{h/2}' {@paint}/>",
   "textBox":["w*inset","4","w-w*inset*2","h-8"],"outline":{"poly":[["w*inset","0"],["w-w*inset","0"],["w","h/2"],["w-w*inset","h"],["w*inset","h"],["0","h/2"]]}},

  {"id":"octagon","name":"Octagon","category":"basic","tags":["stop","polygon"],"description":"Octagon","size":[120,120],
   "style":{"fill":"#ffffff","stroke":"#1f2328","strokeWidth":2},"text":{"size":15,"color":"#1f2328"},
   "svg":"<polygon points='{w*0.29},{sw/2} {w*0.71},{sw/2} {w-sw/2},{h*0.29} {w-sw/2},{h*0.71} {w*0.71},{h-sw/2} {w*0.29},{h-sw/2} {sw/2},{h*0.71} {sw/2},{h*0.29}' {@paint}/>",
   "textBox":["w*0.15","h*0.15","w*0.7","h*0.7"]},

  {"id":"parallelogram","name":"Parallelogram","category":"flowchart","tags":["input","output","data","io"],"description":"Parallelogram (flowchart data / IO); skew is fraction of width","size":[170,80],
   "params":{"skew":{"type":"number","default":0.18,"min":-0.5,"max":0.5,"step":0.01,"label":"Skew"}},
   "style":{"fill":"#ffffff","stroke":"#1f2328","strokeWidth":2},"text":{"size":15,"color":"#1f2328"},
   "svg":"<polygon points='{max(0,w*skew)+sw/2},{sw/2} {w-sw/2-max(0,-w*skew)},{sw/2} {w-sw/2-max(0,w*skew)},{h-sw/2} {sw/2+max(0,-w*skew)},{h-sw/2}' {@paint}/>",
   "textBox":["abs(w*skew)","4","w-abs(w*skew)*2","h-8"],"outline":{"poly":[["max(0,w*skew)","0"],["w-max(0,-w*skew)","0"],["w-max(0,w*skew)","h"],["max(0,-w*skew)","h"]]}},

  {"id":"trapezoid","name":"Trapezoid","category":"flowchart","tags":["manual operation"],"description":"Trapezoid, narrower at the top for positive inset","size":[170,80],
   "params":{"inset":{"type":"number","default":0.18,"min":-0.45,"max":0.45,"step":0.01,"label":"Inset"}},
   "style":{"fill":"#ffffff","stroke":"#1f2328","strokeWidth":2},"text":{"size":15,"color":"#1f2328"},
   "svg":"<polygon points='{max(0,w*inset)+sw/2},{sw/2} {w-max(0,w*inset)-sw/2},{sw/2} {w-max(0,-w*inset)-sw/2},{h-sw/2} {max(0,-w*inset)+sw/2},{h-sw/2}' {@paint}/>",
   "textBox":["abs(w*inset)","4","w-abs(w*inset)*2","h-8"]},

  {"id":"cylinder","name":"Cylinder","category":"flowchart","tags":["database","storage","db","disk"],"description":"Cylinder (database); cap is the ellipse height as a fraction of the box height","size":[110,130],
   "params":{"cap":{"type":"number","default":0.12,"min":0.02,"max":0.4,"step":0.01,"label":"Cap"}},
   "style":{"fill":"#ffffff","stroke":"#1f2328","strokeWidth":2},"text":{"size":15,"color":"#1f2328"},
   "svg":"<path d='M{sw/2},{h*cap} A{w/2-sw/2},{h*cap-sw/2} 0 0 1 {w-sw/2},{h*cap} L{w-sw/2},{h-h*cap} A{w/2-sw/2},{h*cap-sw/2} 0 0 1 {sw/2},{h-h*cap} Z' {@paint}/><path d='M{sw/2},{h*cap} A{w/2-sw/2},{h*cap-sw/2} 0 0 0 {w-sw/2},{h*cap}' fill='none' stroke='{stroke}' stroke-width='{sw}'/>",
   "textBox":["4","h*cap*2","w-8","h-h*cap*3"]},

  {"id":"cloud","name":"Cloud","category":"basic","tags":["internet","cloud","weather"],"description":"Cloud outline","size":[180,110],"viewBox":[0,0,100,60],
   "style":{"fill":"#ffffff","stroke":"#1f2328","strokeWidth":2},"text":{"size":15,"color":"#1f2328"},
   "svg":"<path d='M24,58.5 C9,58.5 1.5,47 6.5,37.5 C0.5,26.5 10,15.5 22,18.5 C26,5.5 44,0.5 55,8.5 C64,0.5 82,3 85.5,16.5 C97,17.5 99.5,32 94,40 C99.5,50 92,59 80,58.5 Z' {@vpaint}/>",
   "textBox":["w*0.18","h*0.3","w*0.64","h*0.6"],"outline":"ellipse"},

  {"id":"blob","name":"Blob","category":"decor","tags":["organic","shape","cloud","centre"],"description":"Soft organic blob, slightly irregular rounded shape","size":[200,170],"viewBox":[0,0,100,100],
   "params":{"wobble":{"type":"number","default":1,"min":0,"max":2,"step":0.05,"label":"Wobble"}},
   "style":{"fill":"#dcdcdc","stroke":"none","strokeWidth":0},"text":{"size":22,"color":"#1f2328","weight":700},
   "svg":"<path d='M{50-wobble*2},{1} C{78+wobble*3},{0-wobble*2} {99},{22-wobble*4} {98-wobble},{50} C{97},{80+wobble*3} {74+wobble*2},{99} {46},{98-wobble*2} C{18-wobble*2},{97} {1},{78-wobble*3} {2+wobble*1.5},{48} C{3},{20-wobble*2} {22-wobble*3},{2+wobble} {50-wobble*2},{1} Z' {@vpaint}/>",
   "textBox":["w*0.04","h*0.15","w*0.92","h*0.7"],"outline":"ellipse"},

  {"id":"document","name":"Document","category":"flowchart","tags":["file","paper","report"],"description":"Document with wavy bottom edge","size":[150,100],
   "params":{"wave":{"type":"number","default":0.1,"min":0,"max":0.3,"step":0.01,"label":"Wave"}},
   "style":{"fill":"#ffffff","stroke":"#1f2328","strokeWidth":2},"text":{"size":15,"color":"#1f2328"},
   "svg":"<path d='M{sw/2},{sw/2} L{w-sw/2},{sw/2} L{w-sw/2},{h-h*wave} C{w*0.72},{h-h*wave*2.6} {w*0.3},{h+h*wave*0.5} {sw/2},{h-h*wave} Z' {@paint}/>",
   "textBox":["6","4","w-12","h-h*wave*2-4"]},

  {"id":"note","name":"Sticky note","category":"basic","tags":["sticky","post-it","note","card"],"description":"Sticky note with soft shadow; fold > 0 draws a folded corner","size":[160,160],
   "params":{"fold":{"type":"number","default":0,"min":0,"max":80,"label":"Corner fold"},"radius":{"type":"number","default":2,"min":0,"max":40,"label":"Corner radius"}},
   "style":{"fill":"#fde68a","stroke":"none","strokeWidth":0,"shadow":"0 4 8 rgba(0,0,0,0.16)"},"text":{"size":16,"color":"#1f2328"},
   "svg":"{#if fold>0}<path d='M0,0 H{w} V{h-fold} L{w-fold},{h} H0 Z' {@paint}/><path d='M{w-fold},{h} V{h-fold} H{w} Z' fill='{shade(fill,-0.15)}'/>{else}<rect x='{sw/2}' y='{sw/2}' width='{w-sw}' height='{h-sw}' rx='{radius}' {@paint}/>{/if}",
   "textBox":["12","12","w-24","h-24"]},

  {"id":"callout","name":"Speech bubble","category":"basic","tags":["callout","comment","speech","bubble","tooltip"],"description":"Rounded speech bubble with a tail along the bottom; tailX positions the tail (0..1)","size":[200,110],
   "params":{"radius":{"type":"number","default":12,"min":0,"max":60,"label":"Corner radius"},"tail":{"type":"number","default":18,"min":0,"max":80,"label":"Tail size"},"tailX":{"type":"number","default":0.25,"min":0.05,"max":0.95,"step":0.01,"label":"Tail position"}},
   "style":{"fill":"#ffffff","stroke":"#1f2328","strokeWidth":2},"text":{"size":15,"color":"#1f2328"},
   "svg":"<path d='M{radius},{sw/2} H{w-radius} Q{w-sw/2},{sw/2} {w-sw/2},{radius} V{h-tail-radius} Q{w-sw/2},{h-tail} {w-radius},{h-tail} H{w*tailX+tail*0.7} L{w*tailX-tail*0.1},{h-sw/2} L{w*tailX-tail*0.3},{h-tail} H{radius} Q{sw/2},{h-tail} {sw/2},{h-tail-radius} V{radius} Q{sw/2},{sw/2} {radius},{sw/2} Z' {@paint}/>",
   "textBox":["8","4","w-16","h-tail-8"]},

  {"id":"star","name":"Star","category":"basic","tags":["favourite","rating"],"description":"Star with n points; inner is the inner radius ratio","size":[120,115],
   "params":{"n":{"type":"number","default":5,"min":3,"max":24,"step":1,"label":"Points"},"inner":{"type":"number","default":0.45,"min":0.1,"max":0.95,"step":0.01,"label":"Inner radius"}},
   "style":{"fill":"#fcd34d","stroke":"#1f2328","strokeWidth":2},"text":{"size":14,"color":"#1f2328"},
   "svg":"<polygon points='{#repeat i n*2}{w/2+(i%2==0?1:inner)*(w/2-sw)*sin(i*PI/n)},{h/2-(i%2==0?1:inner)*(h/2-sw)*cos(i*PI/n)} {/repeat}' {@paint}/>",
   "textBox":["w*0.3","h*0.35","w*0.4","h*0.35"],"outline":"ellipse"},

  {"id":"block-arrow","name":"Block arrow","category":"basic","tags":["arrow","direction","next"],"description":"Fat arrow pointing right (rotate for other directions); head = head length fraction, shaft = shaft thickness fraction","size":[180,90],
   "params":{"head":{"type":"number","default":0.35,"min":0.05,"max":0.9,"step":0.01,"label":"Head length"},"shaft":{"type":"number","default":0.5,"min":0.1,"max":1,"step":0.01,"label":"Shaft thickness"}},
   "style":{"fill":"#ffffff","stroke":"#1f2328","strokeWidth":2},"text":{"size":15,"color":"#1f2328"},
   "svg":"<polygon points='{sw/2},{h*(1-shaft)/2} {w-w*head},{h*(1-shaft)/2} {w-w*head},{sw/2} {w-sw/2},{h/2} {w-w*head},{h-sw/2} {w-w*head},{h-h*(1-shaft)/2} {sw/2},{h-h*(1-shaft)/2}' {@paint}/>",
   "textBox":["4","h*(1-shaft)/2","w-w*head","h*shaft"]},

  {"id":"chevron","name":"Chevron","category":"basic","tags":["step","process","stage","arrow"],"description":"Chevron / process step pointing right; depth is the notch depth as a fraction of width","size":[180,70],
   "params":{"depth":{"type":"number","default":0.15,"min":0,"max":0.5,"step":0.01,"label":"Depth"},"notch":{"type":"boolean","default":true,"label":"Notched start"}},
   "style":{"fill":"#ffffff","stroke":"#1f2328","strokeWidth":2},"text":{"size":15,"color":"#1f2328"},
   "svg":"<polygon points='{sw/2},{sw/2} {w-w*depth},{sw/2} {w-sw/2},{h/2} {w-w*depth},{h-sw/2} {sw/2},{h-sw/2} {notch?w*depth:sw/2},{h/2}' {@paint}/>",
   "textBox":["w*depth+4","4","w-w*depth*2-8","h-8"]},

  {"id":"plus","name":"Plus","category":"basic","tags":["cross","add"],"description":"Plus / cross shape; t is arm thickness fraction","size":[100,100],
   "params":{"t":{"type":"number","default":0.32,"min":0.05,"max":0.9,"step":0.01,"label":"Thickness"}},
   "style":{"fill":"#ffffff","stroke":"#1f2328","strokeWidth":2},"text":{"size":14,"color":"#1f2328"},
   "svg":"<polygon points='{w*(1-t)/2},{sw/2} {w*(1+t)/2},{sw/2} {w*(1+t)/2},{h*(1-t)/2} {w-sw/2},{h*(1-t)/2} {w-sw/2},{h*(1+t)/2} {w*(1+t)/2},{h*(1+t)/2} {w*(1+t)/2},{h-sw/2} {w*(1-t)/2},{h-sw/2} {w*(1-t)/2},{h*(1+t)/2} {sw/2},{h*(1+t)/2} {sw/2},{h*(1-t)/2} {w*(1-t)/2},{h*(1-t)/2}' {@paint}/>",
   "textBox":["w*(1-t)/2","h*(1-t)/2","w*t","h*t"]},

  {"id":"line","name":"Line","category":"basic","tags":["divider","separator","rule","underline"],"description":"Straight horizontal line across the box (decorative divider, not a connector). Rotate for vertical.","size":[200,8],
   "style":{"stroke":"#1f2328","strokeWidth":2,"fill":"none"},
   "svg":"<path d='M0,{h/2} H{w}' fill='none' stroke='{stroke}' stroke-width='{sw}' stroke-dasharray='{dash}'/>",
   "textBox":["0","h/2+4","w","20"]},

  {"id":"container","name":"Container","category":"containers","tags":["group","frame","panel","section","card","header"],"description":"Panel with optional header band (fill2) on top; the element text is the header title. header=0 hides the band.","size":[320,220],
   "params":{"header":{"type":"number","default":40,"min":0,"max":400,"label":"Header height"},"radius":{"type":"number","default":8,"min":0,"max":60,"label":"Corner radius"},"divider":{"type":"boolean","default":true,"label":"Divider line"}},
   "style":{"fill":"#ffffff","fill2":"#f1f3f5","stroke":"#c9ced6","strokeWidth":1.5},"text":{"size":15,"weight":600,"color":"#1f2328","align":"left","valign":"middle"},
   "svg":"<rect x='{sw/2}' y='{sw/2}' width='{w-sw}' height='{h-sw}' rx='{radius}' fill='{fill}' stroke='none'/>{#if header>0}<path d='M{sw/2},{min(header,h)} V{radius} Q{sw/2},{sw/2} {radius},{sw/2} H{w-radius} Q{w-sw/2},{sw/2} {w-sw/2},{radius} V{min(header,h)} Z' fill='{fill2}'/>{#if divider}<path d='M{sw/2},{min(header,h)} H{w-sw/2}' stroke='{stroke}' stroke-width='{sw}'/>{/if}{/if}<rect x='{sw/2}' y='{sw/2}' width='{w-sw}' height='{h-sw}' rx='{radius}' fill='none' stroke='{stroke}' stroke-width='{sw}' stroke-dasharray='{dash}'/>",
   "textBox":["12","0","w-24","header>0?header:28"]},

  {"id":"lane","name":"Swimlane","category":"containers","tags":["swimlane","lane","row","band","pool","group"],"description":"Horizontal swimlane: body plus a header strip (fill2) on the left with vertical title text","size":[600,140],
   "params":{"header":{"type":"number","default":36,"min":0,"max":300,"label":"Header width"},"radius":{"type":"number","default":0,"min":0,"max":40,"label":"Corner radius"}},
   "style":{"fill":"#f5f7fa","fill2":"#c9d4e3","stroke":"none","strokeWidth":0},"text":{"size":14,"weight":600,"color":"#1f2328","vertical":true},
   "svg":"<rect x='{sw/2}' y='{sw/2}' width='{w-sw}' height='{h-sw}' rx='{radius}' {@paint}/><path d='M{header},{sw/2} H{radius+sw/2} Q{sw/2},{sw/2} {sw/2},{radius+sw/2} V{h-radius-sw/2} Q{sw/2},{h-sw/2} {radius+sw/2},{h-sw/2} H{header} Z' fill='{fill2}'/>",
   "textBox":["0","0","header","h"]},

  {"id":"card","name":"Card","category":"containers","tags":["tile","panel","accent","kanban"],"description":"Card with a coloured accent bar (fill2) on one side (accentSide top|left)","size":[220,120],
   "params":{"radius":{"type":"number","default":8,"min":0,"max":40,"label":"Corner radius"},"accent":{"type":"number","default":6,"min":0,"max":80,"label":"Accent size"},"accentSide":{"type":"select","default":"top","options":["top","left"],"label":"Accent side"}},
   "style":{"fill":"#ffffff","fill2":"#6366f1","stroke":"#e1e4e8","strokeWidth":1,"shadow":"0 2 6 rgba(0,0,0,0.10)"},"text":{"size":15,"color":"#1f2328","align":"left","valign":"top"},
   "svg":"<clipPath id='cl{uid}'><rect x='0' y='0' width='{w}' height='{h}' rx='{radius}'/></clipPath><rect x='{sw/2}' y='{sw/2}' width='{w-sw}' height='{h-sw}' rx='{radius}' {@paint}/><rect clip-path='url(#cl{uid})' x='0' y='0' width='{accentSide==\"left\"?accent:w}' height='{accentSide==\"left\"?h:accent}' fill='{fill2}'/>",
   "textBox":["accentSide=='left'?accent+12:12","accentSide=='left'?12:accent+10","w-24-(accentSide=='left'?accent:0)","h-22-(accentSide=='left'?0:accent)"]},

  {"id":"frame","name":"Frame","category":"containers","tags":["artboard","frame","board","area"],"description":"Board frame: plain area with its title shown above the top-left corner","size":[480,320],
   "params":{"radius":{"type":"number","default":0,"min":0,"max":40,"label":"Corner radius"}},
   "style":{"fill":"#ffffff","stroke":"#d0d7de","strokeWidth":1},"text":{"size":13,"color":"#6e7781","align":"left","valign":"bottom"},
   "svg":"<rect x='{sw/2}' y='{sw/2}' width='{w-sw}' height='{h-sw}' rx='{radius}' {@paint}/>",
   "textBox":["0","-26","w","22"]}
]
