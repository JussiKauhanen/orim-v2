 with a group. Bring in the roles and people you think will be most helpful, but keep the group fairly small – six or fewer.","align":"left","valign":"top","font":"Open Sans","size":6.4,"weight":400,"color":"#ffffff","lineHeight":1.45}},{"id":"eko","kind":"rect","x":80,"y":207,"w":319,"h":159,"params":{},"style":{"fill":"#1e46a0","stroke":"none"},"text":{}},{"id":"ekp","kind":"text","x":86,"y":211,"w":140,"h":12,"params":{},"style":{},"text":{"content":"Prep","align":"left","valign":"top","font":"Open Sans","size":7.4,"weight":400,"color":"#ffffff","lineHeight":1.45}},{"id":"ekq","kind":"text","x":86,"y":233,"w":300,"h":50,"params":{},"style":{},"text":{"content":"Start with a question that is central to your topic or problem. Make sure the question is somewhat specific – e.g., \"How can we make creating Jira issues simpler?\" is better than \"How can we improve Jira issues?\"","align":"left","valign":"top","font":"Open Sans","size":6.4,"weight":400,"color":"#ffffff","lineHeight":1.45}},{"id":"ekr","kind":"rect","x":408,"y":36,"w":486,"h":330,"params":{},"style":{"fill":"#e0ebfd","stroke":"none"},"text":{}},{"id":"eks","kind":"rect","x":81,"y":377,"w":316,"h":140,"params":{},"style":{"fill":"#1c2a4b","stroke":"none"},"text":{}},{"id":"ekt","kind":"text","x":220,"y":440,"w":40,"h":70,"params":{},"style":{},"text":{"content":"1","align":"center","valign":"middle","font":"Open Sans","size":50,"weight":400,"color":"#1e46a0"}},{"id":"eku","kind":"text","x":86,"y":381,"w":100,"h":12,"params":{},"style":{},"text":{"content":"Step 1","align":"left","valign":"top","font":"Open Sans","size":7.4,"weight":400,"color":"#ffffff","lineHeight":1.45}},{"id":"ekv","kind":"text","x":116,"y":398,"w":271,"h":12,"params":{},"style":{},"text":{"content":"Turn your brain on","align":"left","valign":"top","font":"Open Sans","size":7.4,"weight":700,"color":"#ffffff","lineHeight":1.45}},{"id":"ekw","kind":"text","x":116,"y":410,"w":261,"h":80,"params":{},"style":{},"text":{"content":"Write your question in the middle of the board.\nNow write down any thoughts that spring to mind in relation to this question. Each thought should be a separate bubble hovering around the question in the middle. Resist the urge to self-edit or over-think it at this stage. Just let it flow.","align":"left","valign":"top","font":"Open Sans","size":6.4,"weight":400,"color":"#ffffff","lineHeight":1.45}},{"id":"ekx","kind":"note","x":316,"y":483,"w":36,"h":36,"params":{"fold":0,"radius":0},"style":{"fill":"#ffffff","stroke":"none","shadow":"0 1 2 rgba(0,0,0,0.25)"},"text":{"content":"5 min","font":"Open Sans","size":7.5,"color":"#222222","lineHeight":1.3}},{"id":"eky","kind":"rect","x":410,"y":377,"w":155,"h":140,"params":{},"style":{"fill":"#1c2a4b","stroke":"none"},"text":{}},{"id":"ekz","kind":"text","x":467,"y":440,"w":40,"h":70,"params":{},"style":{},"text":{"content":"2","align":"center","valign":"middle","font":"Open Sans","size":50,"weight":400,"color":"#1e46a0"}},{"id":"el0","kind":"text","x":415,"y":381,"w":100,"h":12,"params":{},"style":{},"text":{"content":"Step 2","align":"left","valign":"top","font":"Open Sans","size":7.4,"weight":400,"color":"#ffffff","lineHeight":1.45}},{"id":"el1","kind":"text","x":445,"y":398,"w":110,"h":12,"params":{},"style":{},"text":{"content":"Branch out","align":"left","valign":"top","font":"Open Sans","size":7.4,"weight":700,"color":"#ffffff","lineHeight":1.45}},{"id":"el2","kind":"text","x":445,"y":410,"w":100,"h":80,"params":{},"style":{},"text":{"content":"Once you've got an initial set of ideas, use each one to create a branch of more ideas.","align":"left","valign":"top","font":"Open Sans","size":6.4,"weight":400,"color":"#ffffff","lineHeight":1.45}},{"id":"el3","kind":"note","x":507,"y":483,"w":36,"h":36,"params":{"fold":0,"radius":0},"style":{"fill":"#ffffff","stroke":"none","shadow":"0 1 2 rgba(0,0,0,0.25)"},"text":{"content":"5 min","font":"Open Sans","size":7.5,"color":"#222222","lineHeight":1.3}},{"id":"el4","kind":"rect","x":